{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "AllowReadObjects",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:GetObjectVersion"
			],
			"Resource": "arn:aws:s3:::zomato-elt-demo/raw/*"
		},
		{
			"Sid": "AllowListBucket",
			"Effect": "Allow",
			"Action": [
				"s3:ListBucket",
				"s3:GetBucketLocation"
			],
			"Resource": "arn:aws:s3:::zomato-elt-demo",
			"Condition": {
				"StringLike": { "s3:prefix": ["raw/*"] }
			}
		}
	]
}
